main :: fn -> i64
{
	return factorial(5) + fibbonacci(36)
}

fibbonacci :: fn(x: i64) -> i64
{ 
	if x == 0 
	{
		return x
	}
	else if x == 1 
	{
		return 1
	}
	else 
	{
		return fibbonacci(x - 1) + fibbonacci(x - 2)
	}
}

factorial :: fn(x: i64) -> i64
{
	if x == 0
	{
		return 1
	}
	else
	{
		return x * factorial(x - 1)
	}
}