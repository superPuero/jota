// $ (static) -> purely compile time (similar to c++ consteval) 
addable :: $fn(T: type) -> bool
{
	// $type_check tries to typecheck the content of {...} returns $bool that represents the validity of inner code
	// $type_check accepts comma separated list of declarations, that will act as the mock/fake instances of a give type
	// !!! $type_check returns evaluation of the type checker, not that of the ast, so invalid syntax is not allowed
	return $type_check(left: T, right: T) {
		left + right
	}
}

// angle brackets enclosed identifier (ex: <T>) represents the generic infer unit, this means that it will act as an anchor for the semantic analyzer
// for type inferring
// every generic type of the procedure mush appear exactly once in any of the generic infer units
add :: fn(left: <T>, right: T) -> type_of(right + left) 
	$require(addable(T), "T must be addable")
{

	return right + left
}